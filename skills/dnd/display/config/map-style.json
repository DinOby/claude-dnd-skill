  "painted_map": {
    "_comment": "Prompt for 'painted map from sketch' (battlemap.py). {style}, {legend}, {cols}, {rows}, {place} are filled in. Raise prompt_version when the wording changes: stored maps are then painted anew. 'model' is the image model for painted maps only (other pictures keep image-provider.json).",
    "prompt_version": 5,
    "default_style": "hand-painted tabletop roleplaying battle map, warm muted colours, one even soft light from the upper left, soft shadows, rich small details (wood grain, worn stone, rugs, plants)",
    "prompt": "Repaint this layout sketch as ONE finished, hand-painted top-down battle map of {place} for a tabletop roleplaying game, seen straight from above. Style: {style}. The sketch is an exact floor plan of a {cols} by {rows} square grid: keep every wall, every door opening, every area of water and every piece of furniture exactly where it is, with exactly the same size and shape - do not move, add or remove walls, openings, water or furniture, and do not change the outline of rooms. Colour key of the sketch: {legend}. Paint walls thick and clearly darker than the floors, door openings clearly open, furniture clearly as obstacles with soft shadows. The image must fill the whole frame edge to edge. Absolutely no grid lines or square pattern drawn on the ground (the grid is added later), no text, no letters, no numbers, no symbols, no people, no creatures, no tokens, no frame, no border, no compass, no legend.",
    "verify": {
      "min_wall_accuracy": 0.9,
      "min_water_accuracy": 0.75,
      "min_separation": 18,
      "max_attempts": 3,
      "min_outlier_distance": 55,
      "max_invented_share": 0.035,
      "min_floor_accuracy": 0.75,
      "min_object_share": 0.55
    },
    "model": "gemini-3.1-flash-image"
  }
