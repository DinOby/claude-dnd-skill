{
  "$id": "dnd-engine/protocol/v1/event",
  "title": "Spielstand-Logbuch: ein Ereignis (eine Zeile in game/events.jsonl)",
  "type": "object",
  "required": ["v", "seq", "t", "by", "src", "type", "data"],
  "additionalProperties": false,
  "properties": {
    "v":    {"type": "integer", "enum": [1]},
    "seq":  {"type": "integer", "minimum": 1},
    "t":    {"type": "string", "maxLength": 40},
    "by":   {"type": "string", "maxLength": 64},
    "src":  {"type": "string", "enum": ["game", "push_stats", "tracker", "xp", "test"]},
    "type": {"type": "string", "enum": [
      "hp.set", "hp.temp",
      "condition.set", "condition.add", "condition.remove", "condition.clear",
      "concentration.set",
      "effect.start", "effect.end", "effect.tick",
      "deathsave",
      "slots.set", "slot.use", "slot.restore",
      "hitdice.use", "hitdice.restore",
      "inventory.add", "inventory.remove",
      "xp.set", "xp.award",
      "inspiration.set", "feature.set",
      "turn.order", "turn.current", "turn.round", "turn.clear",
      "tracker.clear",
      "import"
    ]},
    "data": {"type": "object"}
  },
  "dataSchemas": {
    "hp.set":            {"type": "object", "required": ["who"], "properties": {"who": {"type": "string"}, "current": {"type": "integer"}, "max": {"type": "integer"}}},
    "hp.temp":           {"type": "object", "required": ["who", "value"], "properties": {"who": {"type": "string"}, "value": {"type": "integer", "minimum": 0}}},
    "condition.set":     {"type": "object", "required": ["who", "list"], "properties": {"who": {"type": "string"}, "list": {"type": "array", "items": {"type": "string"}}}},
    "condition.add":     {"type": "object", "required": ["who", "name"], "properties": {"who": {"type": "string"}, "name": {"type": "string"}}},
    "condition.remove":  {"type": "object", "required": ["who", "name"], "properties": {"who": {"type": "string"}, "name": {"type": "string"}}},
    "condition.clear":   {"type": "object", "required": ["who"], "properties": {"who": {"type": "string"}}},
    "concentration.set": {"type": "object", "required": ["who"], "properties": {"who": {"type": "string"}, "spell": {"type": ["string", "null"]}}},
    "effect.start":      {"type": "object", "required": ["who", "name"], "properties": {"who": {"type": "string"}, "name": {"type": "string"}, "duration": {"type": "string"}, "conc": {"type": "boolean"}}},
    "effect.end":        {"type": "object", "required": ["who", "name"], "properties": {"who": {"type": "string"}, "name": {"type": "string"}}},
    "effect.tick":       {"type": "object", "required": ["who"], "properties": {"who": {"type": "string"}}},
    "deathsave":         {"type": "object", "required": ["who", "result"], "properties": {"who": {"type": "string"}, "result": {"type": "string", "enum": ["success", "failure", "stable", "reset"]}}},
    "slots.set":         {"type": "object", "required": ["who", "slots"], "properties": {"who": {"type": "string"}, "slots": {"type": "object"}}},
    "slot.use":          {"type": "object", "required": ["who", "level"], "properties": {"who": {"type": "string"}, "level": {"type": "integer", "minimum": 1, "maximum": 9}}},
    "slot.restore":      {"type": "object", "required": ["who", "level"], "properties": {"who": {"type": "string"}, "level": {"type": "integer", "minimum": 1, "maximum": 9}}},
    "hitdice.use":       {"type": "object", "required": ["who", "n"], "properties": {"who": {"type": "string"}, "n": {"type": "integer", "minimum": 1}}},
    "hitdice.restore":   {"type": "object", "required": ["who", "n"], "properties": {"who": {"type": "string"}, "n": {"type": "integer", "minimum": 1}}},
    "inventory.add":     {"type": "object", "required": ["who", "item"], "properties": {"who": {"type": "string"}, "item": {"type": "string"}}},
    "inventory.remove":  {"type": "object", "required": ["who", "item"], "properties": {"who": {"type": "string"}, "item": {"type": "string"}}},
    "xp.set":            {"type": "object", "required": ["who", "current"], "properties": {"who": {"type": "string"}, "current": {"type": "integer", "minimum": 0}, "next": {"type": "integer", "minimum": 0}}},
    "xp.award":          {"type": "object", "required": ["who", "awarded"], "properties": {"who": {"type": "string"}, "awarded": {"type": "integer"}, "total_after": {"type": "integer"}, "note": {"type": "string"}}},
    "inspiration.set":   {"type": "object", "required": ["who", "value"], "properties": {"who": {"type": "string"}, "value": {"type": "boolean"}}},
    "feature.set":       {"type": "object", "required": ["who", "name", "value"], "properties": {"who": {"type": "string"}, "name": {"type": "string"}, "value": {"type": ["boolean", "integer"]}}},
    "turn.order":        {"type": "object", "required": ["order"], "properties": {"order": {"type": "array", "items": {"type": "string"}}, "current": {"type": ["string", "null"]}, "round": {"type": "integer", "minimum": 0}}},
    "turn.current":      {"type": "object", "required": ["who"], "properties": {"who": {"type": "string"}, "round": {"type": "integer", "minimum": 0}}},
    "turn.round":        {"type": "object", "required": ["round"], "properties": {"round": {"type": "integer", "minimum": 0}}},
    "turn.clear":        {"type": "object", "properties": {}},
    "tracker.clear":     {"type": "object", "properties": {"all": {"type": "boolean"}}},
    "import":            {"type": "object", "required": ["source", "characters"], "properties": {"source": {"type": "string"}, "characters": {"type": "object"}}}
  }
}
